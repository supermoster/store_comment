###############################################################################
#  FoodieGo API Test Suite
#  Usage: click the ▶ button next to each ### to send the request
#  Run the login request in the "User" section first, then copy the token
###############################################################################

# ==================== 环境变量 ====================
@baseUrl = http://localhost:8081
@token = {{login.response.body.data.token}}


###############################################################################
#                                商铺类型模块
###############################################################################

### 1. 查询所有商铺类型
GET {{baseUrl}}/shop-type/list


###############################################################################
#                                商铺模块 /shop
###############################################################################

### 2. 查询商铺详情（根据id）
GET {{baseUrl}}/shop/1

### 3. 按类型分页查询商铺（美食 typeId=1）
GET {{baseUrl}}/shop/of/type?typeId=1&current=1

### 4. 按类型分页查询商铺（KTV typeId=2）
GET {{baseUrl}}/shop/of/type?typeId=2&current=1

### 5. 按类型分页+坐标查询（带地理位置排序）
GET {{baseUrl}}/shop/of/type?typeId=1&current=1&x=120.15&y=30.32

### 6. 按名称关键字搜索商铺
GET {{baseUrl}}/shop/of/name?name=茶餐厅&current=1

### 7. 新增商铺
POST {{baseUrl}}/shop
Content-Type: application/json

{
  "name": "测试茶餐厅",
  "typeId": 1,
  "images": "/imgs/test.jpg",
  "area": "西湖区",
  "address": "杭州市西湖区测试路168号",
  "x": 120.155,
  "y": 30.28,
  "avgPrice": 68,
  "sold": 0,
  "comments": 0,
  "score": 45,
  "openHours": "10:00-22:00"
}

### 8. 更新商铺信息
PUT {{baseUrl}}/shop
Content-Type: application/json

{
  "id": 1,
  "name": "103茶餐厅（已更新）",
  "typeId": 1,
  "images": "https://qcloud.dpfile.com/pc/jiclIsCKmOI2arxKN1Uf0Hx3PucIJH8q0QSz-Z8llzcN56-_QiKuOvyio1OOxsRtFoXqu0G3iT2T27qat3WhLVEuLYk00OmSS1IdNpm8K8sG4JN9RIm2mTKcbLtc2o2vfCF2ubeXzk49OsGrXt_KYDCngOyCwZK-s3fqawWswzk.jpg",
  "area": "大关（已更新）",
  "address": "金华路锦昌文华苑29号",
  "x": 120.149192,
  "y": 30.316078,
  "avgPrice": 85,
  "sold": 4215,
  "comments": 3035,
  "score": 37,
  "openHours": "10:00-22:00"
}


###############################################################################
#                                用户模块 /user
###############################################################################

### 9. 发送短信验证码
POST {{baseUrl}}/user/code?phone=13686869696

### 10. 登录（验证码方式）
POST {{baseUrl}}/user/login
Content-Type: application/json

{
  "phone": "13686869696",
  "code": "1234"
}

### 11. 登录（密码方式）
POST {{baseUrl}}/user/login
Content-Type: application/json

{
  "phone": "13686869696",
  "password": "123456"
}

### 12. 获取当前登录用户信息
GET {{baseUrl}}/user/me

### 13. 查用户信息（根据id）
GET {{baseUrl}}/user/1

### 14. 查用户详情（UserInfo）-- 需要token
GET {{baseUrl}}/user/info/1

### 15. 用户签到 -- 需要token
PUT {{baseUrl}}/user/sign

### 16. 查询本月签到次数 -- 需要token
GET {{baseUrl}}/user/sign

### 17. 登出
POST {{baseUrl}}/user/logout


###############################################################################
#                               笔记模块 /blog
###############################################################################

### 18. 查询热门笔记
GET {{baseUrl}}/blog/hot?current=1

### 19. 查询笔记详情
GET {{baseUrl}}/blog/4

### 20. 查询笔记点赞列表
GET {{baseUrl}}/blog/likes/4

### 21. 查询某用户的笔记列表
GET {{baseUrl}}/blog/of/user?current=1&id=2

### 22. 查询我的笔记 -- 需要token
GET {{baseUrl}}/blog/of/me?current=1

### 23. 查询关注用户的笔记 -- 需要token
GET {{baseUrl}}/blog/of/follow?lastId=999&offset=0

### 24. 发布笔记 -- 需要token
POST {{baseUrl}}/blog
Content-Type: application/json

{
  "shopId": 1,
  "title": "测试笔记标题",
  "images": "/imgs/blogs/blog1.jpg",
  "content": "这是一篇测试笔记的内容"
}

### 25. 点赞/取消点赞笔记 -- 需要token
PUT {{baseUrl}}/blog/like/4


###############################################################################
#                            优惠券模块 /voucher
###############################################################################

### 26. 查询商铺的优惠券列表
GET {{baseUrl}}/voucher/list/1

### 27. 新增普通优惠券
POST {{baseUrl}}/voucher
Content-Type: application/json

{
  "shopId": 1,
  "title": "满100减20",
  "subTitle": "新客专享",
  "rules": "满100元可用，每桌限用一张",
  "payValue": 80,
  "actualValue": 100,
  "type": 1,
  "status": 1
}

### 28. 新增秒杀券（含秒杀时间窗口）
POST {{baseUrl}}/voucher/seckill
Content-Type: application/json

{
  "shopId": 1,
  "title": "1元秒杀！满50减49",
  "subTitle": "限时秒杀",
  "rules": "每人限购1张，有效期7天",
  "payValue": 1,
  "actualValue": 50,
  "type": 1,
  "status": 1,
  "stock": 100,
  "beginTime": "2026-06-25T10:00:00",
  "endTime": "2026-06-25T12:00:00"
}


###############################################################################
#                          下单模块 /voucher-order
###############################################################################

### 29. 普通优惠券下单 -- 需要token
POST {{baseUrl}}/voucher-order/1

### 30. 秒杀券下单 -- 需要token（受Sentinel限流保护）
POST {{baseUrl}}/voucher-order/seckill/1

### 31. Redis连通性测试
GET {{baseUrl}}/voucher-order/ping-redis


###############################################################################
#                            关注模块 /follow
###############################################################################

### 32. 关注/取关用户 -- 需要token
PUT {{baseUrl}}/follow/2/true

### 33. 取关用户 -- 需要token
PUT {{baseUrl}}/follow/2/false

### 34. 判断是否关注某用户 -- 需要token
GET {{baseUrl}}/follow/or/not/2

### 35. 查询共同关注 -- 需要token
GET {{baseUrl}}/follow/common/1


###############################################################################
#                            文件上传 /upload
###############################################################################

### 36. 上传博客图片（multipart/form-data）
POST {{baseUrl}}/upload/blog
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary

------WebKitFormBoundary
Content-Disposition: form-data; name="file"; filename="test.jpg"
Content-Type: image/jpeg

< ./src/main/resources/imgs/test.jpg
------WebKitFormBoundary--

### 37. 删除博客图片
GET {{baseUrl}}/upload/blog/delete?name=test.jpg


###############################################################################
#                        Actuator 健康检查
###############################################################################

### 38. 应用健康检查
GET {{baseUrl}}/actuator/health

### 39. 应用信息
GET {{baseUrl}}/actuator/info


###############################################################################
#                            测试流程
###############################################################################
# 推荐按以下顺序跑：
#  1. 先跑 31号 测Redis连通性
#  2. 再跑 1号  看商铺类型
#  3. 跑 2号   看商铺详情
#  4. 跑 10号  登录拿token（需要先跑9号发验证码，或直接用11号密码登录）
#  5. 跑 12号  验证登录态
#  6. 之后所有需要token的接口都可以正常跑了
###############################################################################